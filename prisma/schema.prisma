generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}
model News {
  id        String   @id @default(cuid())
  labSlug   String?
  title     String
  content   String
  imageUrl  String?
  date      DateTime @default(now())
  language  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([labSlug])
  @@index([language])
  @@index([date])
}

model Lab {
  id            String   @id @default(cuid())
  slug          String   @unique
  imageUrl      String?
  nameUz        String
  nameRu        String
  nameEn        String
  headUz        String
  headRu        String
  headEn        String
  descriptionUz String   @default("")
  descriptionRu String   @default("")
  descriptionEn String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([slug])
}

model LabPost {
  id        String   @id @default(cuid())
  labSlug   String
  titleUz   String
  titleRu   String?
  titleEn   String?
  imageUrl  String?
  videoUrl  String?
  contentUz String
  contentRu String?
  contentEn String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([labSlug])
  @@index([createdAt])
}

// Bosh sahifa orqa foni va sozlamalarini saqlash uchun yangi model
model SiteSettings {
  id            String   @id @default("settings")
  heroVideoUrl  String?  // Video havolasi (masalan, .mp4)
  heroPosterUrl String?  // Video yuklanmaguncha/bo'lmaganda ko'rinadigan rasm URL
  updatedAt     DateTime @updatedAt
}