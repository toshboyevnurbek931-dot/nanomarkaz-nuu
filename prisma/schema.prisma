generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model News {
  id        String   @id @default(cuid())
  title     String
  content   String
  imageUrl  String?
  date      DateTime @default(now())
  language  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Lab {
  id             String   @id @default(cuid())
  slug           String   @unique
  imageUrl       String?  // Laboratoriya rasmi havolasi
  nameUz         String
  nameRu         String
  nameEn         String
  headUz         String
  headRu         String
  headEn         String
  descriptionUz  String   @default("")
  descriptionRu  String   @default("")
  descriptionEn  String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
model LabPost {
  id        String   @id @default(cuid())
  labSlug   String   // Tanlangan laboratoriya (masalan: kvant-fotonikasi)
  titleUz   String
  titleRu   String?
  titleEn   String?
  imageUrl  String?
  contentUz String
  contentRu String?
  contentEn String?
  createdAt DateTime @default(now())
}